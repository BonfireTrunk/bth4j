<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>today.bonfire.oss</groupId>
        <artifactId>bth4j-parent</artifactId>
        <version>3.0.0</version>
    </parent>

    <artifactId>bth4j-redis</artifactId>
    <packaging>jar</packaging>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>Redis TaskStore for bth4j: one hash per task, atomic Lua transitions, lease tokens. Requires Redis 7.0 or newer.</description>

    <properties>
        <module.name>bonfire.oss.bth4j.redis</module.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>today.bonfire.oss</groupId>
            <artifactId>bth4j-core</artifactId>
        </dependency>
        <dependency>
            <groupId>today.bonfire.oss</groupId>
            <artifactId>jedis</artifactId>
        </dependency>

        <dependency>
            <groupId>today.bonfire.oss</groupId>
            <artifactId>bth4j-store-tests</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- integration tests against a real Redis (Testcontainers, needs Docker) -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
