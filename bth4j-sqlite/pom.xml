<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>today.bonfire.oss</groupId>
        <artifactId>bth4j-parent</artifactId>
        <version>4.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>bth4j-sqlite</artifactId>
    <packaging>jar</packaging>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>SQLite TaskStore for bth4j: one row per task, claims and every other write in IMMEDIATE transactions, revision-checked updates. Uses only java.sql; the application supplies the JDBC driver. SQLite 3.45 or newer in WAL mode, for one or more processes on one machine, tested on 3.54.</description>

    <properties>
        <module.name>bonfire.oss.bth4j.sqlite</module.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>today.bonfire.oss</groupId>
            <artifactId>bth4j-core</artifactId>
        </dependency>

        <dependency>
            <groupId>today.bonfire.oss</groupId>
            <artifactId>bth4j-store-tests</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>today.bonfire.oss</groupId>
            <artifactId>bth4j-testing</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
