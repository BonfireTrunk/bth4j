<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>today.bonfire.oss</groupId>
        <artifactId>bonfire-oss-parent</artifactId>
        <version>2.1.1</version>
    </parent>

    <groupId>today.bonfire.oss</groupId>
    <artifactId>bth4j-parent</artifactId>
    <version>3.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <modules>
        <module>bth4j-core</module>
        <module>bth4j-store-tests</module>
        <module>bth4j-testing</module>
        <module>bth4j-redis</module>
        <module>bth4j-postgres</module>
        <module>bth4j-micrometer</module>
        <module>bth4j-admin-http</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <jedis.version>8.0.2</jedis.version>
        <cron-utils.version>9.2.1</cron-utils.version>
        <testcontainers.version>2.0.5</testcontainers.version>
        <fastjson2.version>2.0.56</fastjson2.version>
        <postgresql.version>42.7.14</postgresql.version>
        <micrometer.version>1.15.0</micrometer.version>
        <hikaricp.version>7.1.0</hikaricp.version>
        <maven-failsafe-plugin.version>3.6.1</maven-failsafe-plugin.version>
    </properties>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>A Java library for asynchronous task management.
        Handles delayed, recurring tasks, offers flexible configuration, and includes callbacks for monitoring task lifecycle events.
        Designed for high availability and efficient resource utilization.

    </description>
    <url>https://github.com/BonfireTrunk/bth4j</url>

    <licenses>
        <license>
            <name>Mozilla Public License Version 2.0</name>
            <url>https://www.mozilla.org/en-US/MPL/2.0/</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Bonfire Team</name>
            <email>oss@bonfire.today</email>
            <organization>Bonfire</organization>
            <organizationUrl>https://github.com/BonfireTrunk</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/BonfireTrunk/bth4j.git</connection>
        <developerConnection>scm:git:ssh://github.com/BonfireTrunk/bth4j.git</developerConnection>
        <url>https://github.com/BonfireTrunk/bth4j</url>
        <tag>HEAD</tag>
    </scm>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>today.bonfire.oss</groupId>
                <artifactId>bth4j-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>today.bonfire.oss</groupId>
                <artifactId>bth4j-store-tests</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>today.bonfire.oss</groupId>
                <artifactId>bth4j-testing</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>today.bonfire.oss</groupId>
                <artifactId>jedis</artifactId>
                <version>${jedis.version}</version>
            </dependency>
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>
            <dependency>
                <groupId>com.zaxxer</groupId>
                <artifactId>HikariCP</artifactId>
                <version>${hikaricp.version}</version>
            </dependency>
            <dependency>
                <groupId>com.cronutils</groupId>
                <artifactId>cron-utils</artifactId>
                <version>${cron-utils.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba.fastjson2</groupId>
                <artifactId>fastjson2</artifactId>
                <version>${fastjson2.version}</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestFile>${project.build.outputDirectory}/META-INF/MANIFEST.MF</manifestFile>
                        <manifestEntries>
                            <Automatic-Module-Name>${module.name}</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.felix</groupId>
                    <artifactId>maven-bundle-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>bundle-manifest</id>
                            <phase>process-classes</phase>
                            <goals>
                                <goal>manifest</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
                <plugin>
                    <!-- runs *IT classes (Testcontainers) in the integration-test phase; unit tests stay with surefire -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven-failsafe-plugin.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>integration-test</goal>
                                <goal>verify</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
