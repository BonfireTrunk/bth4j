<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>today.bonfire.oss</groupId>
        <artifactId>bth4j-parent</artifactId>
        <version>3.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>bth4j-testing</artifactId>
    <packaging>jar</packaging>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>In-memory store and test clock for testing applications that use bth4j</description>

    <properties>
        <module.name>bonfire.oss.bth4j.testing</module.name>
    </properties>

    <dependencies>
        <dependency>
            <groupId>today.bonfire.oss</groupId>
            <artifactId>bth4j-core</artifactId>
        </dependency>
        <dependency>
            <groupId>today.bonfire.oss</groupId>
            <artifactId>bth4j-store-tests</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
